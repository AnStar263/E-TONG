<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12161F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部标题与蓝牙状态栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2433"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="远程简易示波器终端"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="状态：未连接 (JDY-31-SPP)"
                    android:textColor="#FF6B6B"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#2563EB"
                android:text="连接蓝牙"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 实时测量参数仪表盘 (基本要求 1.a / 1.c) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="实时信号参数监测 (0Hz - 5MHz)"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 第一行：平均电压 & 峰峰值 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#1E2433"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="直流平均电压 (Vavg)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVavg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="-- V"
                    android:textColor="#10B981"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#1E2433"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正弦信号峰峰值 (Vpp)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVpp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="-- V"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第二行：最高电压 & 信号频率 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#1E2433"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="信号最高电压 (Vmax)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVmax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="-- V"
                    android:textColor="#F59E0B"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#1E2433"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="被测信号频率 (Freq)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="-- Hz"
                    android:textColor="#A855F7"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 模块 1：本地显示页面切换控制 (基本要求 1.c & 附加 3.b FFT) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="主控本地显示页面切换"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2433"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPageWave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:text="波形页"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPageParam"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:text="参数页"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPageFft"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7C3AED"
                    android:text="FFT 频谱"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPagePrev"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#475569"
                    android:text="◀ 上一页面"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPageNext"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#475569"
                    android:text="下一页面 ▶"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 模块 2：Y轴分辨率/缩放控制 (1x, 2x, 4x, 8x) -->
        <TextView
            android:id="@+id/tvYScaleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Y轴垂直缩放 / 分辨率控制 (当前: ×1)"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2433"
            android:orientation="horizontal"
            android:padding="10dp">

            <Button
                android:id="@+id/btnY1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#059669"
                android:text="Y ×1"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnY2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="Y ×2"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnY4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="Y ×4"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnY8"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="Y ×8"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 模块 3：X轴分辨率缩放与左右平移控制 (发挥部分 2.a / 2.c) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="X轴时基分辨率与水平平移控制"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2433"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- X轴缩放 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnXZoomIn"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0284C7"
                    android:text="X轴放大 (+)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnXZoomOut"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0284C7"
                    android:text="X轴缩小 (-)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- X轴左右平移 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnXLeft"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:text="⬅ X轴左移"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnXRight"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:text="X轴右移 ➡"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 复位与运行/暂停 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnXReset"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#475569"
                    android:text="坐标居中复位"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRunStop"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#D97706"
                    android:text="运行 / 暂停锁存"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部通信状态回显栏 -->
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#0F172A"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="通信监控：等待操作..."
            android:textColor="#64748B"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>