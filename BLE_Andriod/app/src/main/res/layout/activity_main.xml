<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 主界面容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC"
        android:orientation="vertical">

        <!-- 顶部固定导航栏 (Top Bar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <!-- 左上角三条线按钮 -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="打开菜单"
                android:padding="8dp"
                android:src="@drawable/ic_menu" />

            <!-- 当前页面标题 -->
            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="示波器 - 参数"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 顶部快捷连接按钮 -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#2563EB"
                android:text="连接蓝牙"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- 页面多视图容器 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 页面 1：【参数】界面 (原示波器仪表盘与控制面板) -->
            <ScrollView
                android:id="@+id/pageParameters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 蓝牙连接状态横幅 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="状态：未连接 (JDY-31-SPP)"
                            android:textColor="#EF4444"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 实时测量参数仪表盘 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="实时信号参数监测 (0Hz - 5MHz)"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- 第一行：Vavg & Vpp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:elevation="1dp"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="直流平均电压 (Vavg)"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvVavg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="monospace"
                                android:text="-- V"
                                android:textColor="#059669"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:elevation="1dp"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="正弦信号峰峰值 (Vpp)"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvVpp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="monospace"
                                android:text="-- V"
                                android:textColor="#0284C7"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 第二行：Vmax & Freq -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:elevation="1dp"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="信号最高电压 (Vmax)"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvVmax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="monospace"
                                android:text="-- V"
                                android:textColor="#D97706"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:elevation="1dp"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="被测信号频率 (Freq)"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvFreq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="monospace"
                                android:text="-- Hz"
                                android:textColor="#7C3AED"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 模块 1：本地页面切换 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:text="主控本地显示页面切换"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnPageWave"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#7DD3FC"
                                android:text="波形页"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />

                            <Button
                                android:id="@+id/btnPageParam"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#7DD3FC"
                                android:text="参数页"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />

                            <Button
                                android:id="@+id/btnPageFft"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#818CF8"
                                android:text="FFT 频谱"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="22dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnPagePrev"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#BAE6FD"
                                android:text="◀ 上一页面"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />

                            <Button
                                android:id="@+id/btnPageNext"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#BAE6FD"
                                android:text="下一页面 ▶"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 模块 2：Y轴缩放 -->
                    <TextView
                        android:id="@+id/tvYScaleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Y轴垂直缩放 / 分辨率控制 (当前: ×1)"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <Button
                            android:id="@+id/btnY1"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#2563EB"
                            android:text="Y ×1"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:cornerRadius="22dp" />

                        <Button
                            android:id="@+id/btnY2"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#BAE6FD"
                            android:text="Y ×2"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            app:cornerRadius="22dp" />

                        <Button
                            android:id="@+id/btnY4"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#BAE6FD"
                            android:text="Y ×4"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            app:cornerRadius="22dp" />

                        <Button
                            android:id="@+id/btnY8"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#BAE6FD"
                            android:text="Y ×8"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            app:cornerRadius="22dp" />
                    </LinearLayout>

                    <!-- 模块 3：X轴缩放与平移 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="X轴时基分辨率与水平平移控制"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnXZoomIn"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#7DD3FC"
                                android:text="X轴放大 (+)"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />

                            <Button
                                android:id="@+id/btnXZoomOut"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#7DD3FC"
                                android:text="X轴缩小 (-)"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnXLeft"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#BAE6FD"
                                android:text="⬅ X轴左移"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />

                            <Button
                                android:id="@+id/btnXRight"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#BAE6FD"
                                android:text="X轴右移 ➡"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnXReset"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#E2E8F0"
                                android:text="坐标居中复位"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                app:cornerRadius="22dp" />

                            <Button
                                android:id="@+id/btnRunStop"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F59E0B"
                                android:text="运行 / 暂停锁存"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="22dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 底部通信日志简报 -->
                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:fontFamily="monospace"
                        android:padding="12dp"
                        android:text="通信监控：等待操作..."
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </ScrollView>

            <!-- 页面 2：【控制台】界面 (全新命令行交互与串口终端) -->
            <LinearLayout
                android:id="@+id/pageConsole"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <!-- 终端工具栏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="实时数据与指令交互终端"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnConsoleClear"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#E2E8F0"
                        android:text="清空终端"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>

                <!-- 终端日志滚动显示区 -->
                <ScrollView
                    android:id="@+id/svConsoleLog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvConsoleLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:text="[系统] 串口控制台已就绪...\n"
                        android:textColor="#38BDF8"
                        android:textSize="12sp" />
                </ScrollView>

                <!-- 快捷指令按钮栏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnQuickWave"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E2E8F0"
                        android:text="发 'W'"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnQuickReset"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E2E8F0"
                        android:text="发 '0'"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnQuickStop"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E2E8F0"
                        android:text="发 'S'"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- 底部输入与发送行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etConsoleInput"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:hint="输入自定义指令 (如: W, 1, AT+...)"
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#0F172A"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnConsoleSend"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#2563EB"
                        android:text="发送"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- 抽屉侧边栏 (Drawer: 宽度固定 280dp，露出右侧原界面并自动调暗) -->
    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical">

        <!-- 侧边栏头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#1E293B"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="示波器终端"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="STM32 测量与控制中枢"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 导航选择列表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- 页面项 1：参数 -->
            <TextView
                android:id="@+id/navItemParam"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#E2E8F0"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:text="📊  参数 (测量与示波控制)"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 页面项 2：控制台 -->
            <TextView
                android:id="@+id/navItemConsole"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:text="💻  控制台 (串口命令行)"
                android:textColor="#334155"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>